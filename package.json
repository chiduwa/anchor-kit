{
  "name": "anchor-kit",
  "version": "0.1.0",
  "description": "Canonical hashing, Merkle proofs and Algorand note anchoring for tamper-evident records. No tokens, no custody.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./submit": {
      "types": "./dist/submit.d.ts",
      "default": "./dist/submit.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "RECIPE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:testnet": "ANCHOR_TESTNET=1 vitest run",
    "monitor": "node scripts/monitor.mjs"
  },
  "peerDependencies": {
    "algosdk": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "algosdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "algosdk": "3.9.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
